# PULSO CRM 8.0.0 — Variables de Entorno de la Extensión
# Copiar como .env.local y rellenar con los valores reales de Supabase
# NUNCA subir .env.local a control de versiones

# URL pública del proyecto Supabase (NO es un secreto — es la URL pública del proyecto)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Clave anon pública de Supabase (NO es un secreto — diseñada para uso en cliente)
# La seguridad real está en RLS, no en esta clave.
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# Referencia del proyecto (solo los caracteres antes de .supabase.co)
# Usado para generar host_permissions en el manifest
VITE_SUPABASE_REF=<PROJECT_REF>
